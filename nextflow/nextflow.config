def scaledMemory = { baseMemory, maxMemory, attempt ->
    def baseGb = (baseMemory.toString().tokenize(' ')[0] as int)
    def maxGb = (maxMemory.toString().tokenize(' ')[0] as int)
    def requestedGb = baseGb * (1 << Math.max(0, (attempt as int) - 1))
    return "${Math.min(requestedGb, maxGb)} GB"
}

def scaledGridMemory = { baseMemory, maxMemory, attempt ->
    def baseGb = (baseMemory.toString().tokenize(' ')[0] as int)
    def maxGb = (maxMemory.toString().tokenize(' ')[0] as int)
    def requestedGb = baseGb + (8 * Math.max(0, (attempt as int) - 1))
    return "${Math.min(requestedGb, maxGb)} GB"
}

def scaledRetryMemory = { baseMemory, maxMemory, attempt, maxRetries ->
    def baseGb = (baseMemory.toString().tokenize(' ')[0] as int)
    def maxGb = (maxMemory.toString().tokenize(' ')[0] as int)
    def totalAttempts = Math.max(1, (maxRetries as int) + 1)
    def attemptNum = attempt as int
    if (attemptNum >= totalAttempts) {
        return "${maxGb} GB"
    }
    def requestedGb = baseGb + (8 * Math.max(0, attemptNum - 1))
    return "${Math.min(requestedGb, maxGb)} GB"
}

def resolvedGpuQueue = params.gpu_queue ?: System.getenv('MOCHI_GPU_QUEUE') ?: ''
def resolvedGpuClusterOptions = params.gpu_cluster_options ?: System.getenv('MOCHI_GPU_CLUSTER_OPTIONS') ?: ''
def resolvedGridGpuClusterOptions = params.grid_gpu_cluster_options ?: System.getenv('MOCHI_GRID_GPU_CLUSTER_OPTIONS') ?: resolvedGpuClusterOptions
def resolvedFoldGpuClusterOptions = params.fold_gpu_cluster_options ?: System.getenv('MOCHI_FOLD_GPU_CLUSTER_OPTIONS') ?: resolvedGpuClusterOptions
def resolvedMaxMemoryRetries = (params.max_memory_retries ?: System.getenv('MOCHI_MAX_MEMORY_RETRIES') ?: 3) as int
def resolvedParallelFolds = (params.parallel_folds ?: System.getenv('MOCHI_PARALLEL_FOLDS') ?: 1) as int
def resolvedCpuQueue = params.cpu_queue ?: System.getenv('MOCHI_CPU_QUEUE') ?: ''
def resolvedGridMemory = params.grid_memory ?: System.getenv('GRID_MEMORY') ?: '24 GB'
def resolvedGridMemoryMax = params.grid_memory_max ?: System.getenv('GRID_MEMORY_MAX') ?: '50 GB'
def resolvedFoldMemory = params.fold_memory ?: System.getenv('FOLD_MEMORY') ?: '24 GB'
def resolvedFoldMemoryMax = params.fold_memory_max ?: System.getenv('FOLD_MEMORY_MAX') ?: '50 GB'
def resolvedMergeMemory = params.merge_memory ?: System.getenv('MERGE_MEMORY') ?: '24 GB'
def resolvedMergeMemoryMax = params.merge_memory_max ?: System.getenv('MERGE_MEMORY_MAX') ?: '50 GB'

params {
    gpu_queue = ''
    gpu_cluster_options = ''
    grid_gpu_cluster_options = ''
    fold_gpu_cluster_options = ''
    cpu_queue = ''
    max_memory_retries = 3
    parallel_folds = 1
    grid_memory = '24 GB'
    grid_memory_max = '50 GB'
    fold_memory = '24 GB'
    fold_memory_max = '50 GB'
    merge_memory = '24 GB'
    merge_memory_max = '50 GB'
}

process {
    shell = ["/bin/bash", "-euo", "pipefail"]
    errorStrategy = "terminate"

    withLabel: mochi_gpu {
        cpus = 1
        memory = "50 GB"
        accelerator = 1
    }

    withLabel: mochi_grid_gpu {
        cpus = 1
        memory = { scaledGridMemory(resolvedGridMemory, resolvedGridMemoryMax, task.attempt) }
        accelerator = 1
    }

    withLabel: mochi_fold_gpu {
        cpus = 1
        memory = { scaledGridMemory(resolvedFoldMemory, resolvedFoldMemoryMax, task.attempt) }
        accelerator = 1
        maxForks = resolvedParallelFolds
    }

    withLabel: cpu_summary {
        cpus = 1
        memory = { scaledRetryMemory(resolvedMergeMemory, resolvedMergeMemoryMax, task.attempt, resolvedMaxMemoryRetries) }
    }
}

profiles {
    local {
        process.executor = "local"
    }

    lsf {
        executor {
            perJobMemLimit = true
            queueStatusMaxRetries = 120
            exitReadTimeout = '600 sec'
        }

        process {
            executor = "lsf"

            withLabel: mochi_gpu {
                queue = resolvedGpuQueue
                clusterOptions = resolvedGpuClusterOptions
                cpus = 1
                memory = "50 GB"
                accelerator = 1
            }

            withLabel: mochi_grid_gpu {
                queue = resolvedGpuQueue
                clusterOptions = resolvedGridGpuClusterOptions
                cpus = 1
                memory = { scaledGridMemory(resolvedGridMemory, resolvedGridMemoryMax, task.attempt) }
                accelerator = 1
                maxRetries = resolvedMaxMemoryRetries
                errorStrategy = {
                    def retryableMemoryExitCodes = ((130..145) as List<Integer>) + [104]
                    def retryable = retryableMemoryExitCodes.contains(task.exitStatus as Integer)
                    (retryable && (task.attempt as int) <= resolvedMaxMemoryRetries) ? 'retry' : 'terminate'
                }
            }

            withLabel: mochi_fold_gpu {
                queue = resolvedGpuQueue
                clusterOptions = resolvedFoldGpuClusterOptions
                cpus = 1
                memory = { scaledGridMemory(resolvedFoldMemory, resolvedFoldMemoryMax, task.attempt) }
                accelerator = 1
                maxForks = resolvedParallelFolds
                maxRetries = resolvedMaxMemoryRetries
                errorStrategy = {
                    def retryableMemoryExitCodes = ((130..145) as List<Integer>) + [104]
                    def retryable = retryableMemoryExitCodes.contains(task.exitStatus as Integer)
                    (retryable && (task.attempt as int) <= resolvedMaxMemoryRetries) ? 'retry' : 'terminate'
                }
            }

            withLabel: cpu_summary {
                queue = resolvedCpuQueue
                cpus = 1
                memory = { scaledRetryMemory(resolvedMergeMemory, resolvedMergeMemoryMax, task.attempt, resolvedMaxMemoryRetries) }
                maxRetries = resolvedMaxMemoryRetries
                errorStrategy = {
                    def retryableMemoryExitCodes = ((130..145) as List<Integer>) + [104]
                    retryableMemoryExitCodes.contains(task.exitStatus as Integer) ? 'retry' : 'terminate'
                }
            }
        }
    }
}

cleanup = false

manifest {
    name = "mochi-benchmark"
}
